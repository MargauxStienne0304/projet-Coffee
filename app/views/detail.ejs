<!DOCTYPE html>
<html lang="fr">

<head>
  <!-- Meta -->
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="La boutique de oCoffee des frères Pepper, spécialistes du café à Hauts-de-Cloques">

  <!-- Title -->
  <title>oCoffee</title>

  <!-- Common styles -->
  <link rel="stylesheet" href="/css/reset.css">
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/common.css">
  <link rel="stylesheet" href="/css/layout.css">

  <!-- Common scripts -->
  <script defer src="/js/header.js"></script>

  <!-- Style -->
  <link rel="stylesheet" href="/css/detail.css">
</head>

<body>
  

<%- include ("partials/header.ejs") %>

<main>
      <% for (const coffee of coffees) {%>
      <article class="product">
        
        <div class="product-info">
          <h1><%=coffee.name%></h1>
          <p class="coffee-reference">Référence : <%= coffee.reference%></p>
          <p class="coffee-origin"> Origine : <%=coffee.origin%></p>
          <p class="coffee-price"> Prix au kilo : <%= coffee.price_kg%> /kg</p>
          <p class="coffee-description">Description : <%= coffee.description%></p>
          <p class="coffee-category">Catégorie(s) :</p>
          <ul class="coffee-categories">
              <li><%= coffee.categories %></li>
          </ul>
          <p class="coffee-available">
            <span class="coffee-available-label">Disponibilité :</span>
            <span class="available">✅ <%= coffee.available%></span>
          </p>
        </div>
        
        <div class="product-image">
          <img src="/images/coffees/<%=coffee.reference%>.png" alt="Espresso">
        </div>
      </article>
    <%}%>
  </main>

<%- include ("partials/footer.ejs") %>